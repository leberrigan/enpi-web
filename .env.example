# ── Authentication ───────────────────────────────────────────────────────────
# Shared password for the web dashboard
AUTH_PASSWORD=change-me-to-a-strong-password

# Secret used to sign JWT session cookies (min 32 random characters)
JWT_SECRET=generate-with-openssl-rand-base64-32

# ── AWS credentials (read-only access to enpi-sensors bucket) ────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ── S3 ───────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=enpi-sensors

# ── Lambda (needed for bootstrap to trigger historical summary generation) ───
# Find this in AWS Console → Lambda → enpi-process-upload → Function ARN
LAMBDA_FUNCTION_NAME=enpi-process-upload
